{
    "name": "nextjs-redux-graphql-boilerplate-client",
    "version": "0.1.0",
    "private": true,
    "description": "Next.js + React + Redux Toolkit boilerplate with FullCalendar, wired for the express-typescript-graphql-boilerplate-server auth API",
    "scripts": {
        "dev": "next dev -p 2400",
        "build": "next build",
        "start": "next start -p 2400",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "codegen": "graphql-codegen",
        "codegen:watch": "graphql-codegen --watch"
    },
    "dependencies": {
        "@fullcalendar/react": "^7.1.3",
        "@fullcalendar/react-scheduler": "^7.1.3",
        "@reduxjs/toolkit": "^2.13.0",
        "exceljs": "^4.4.0",
        "graphql": "^17.0.2",
        "next": "^16.4.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.0",
        "temporal-polyfill": "^1.0.1"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.4.6",
        "@graphql-codegen/client-preset": "^6.2.3",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.2",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "^5"
    }
}
