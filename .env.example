# GraphQL endpoint of express-typescript-graphql-boilerplate-server
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:2200/graphql

# Set to "true" to run the UI without a backend (in-browser mock of the auth/users operations).
# Any email/password logs in; register creates a mock user.
NEXT_PUBLIC_MOCK_API=false

# FullCalendar Premium (resource views). The non-commercial key is fine for development;
# use your commercial key in production. https://fullcalendar.io/license
NEXT_PUBLIC_FULLCALENDAR_LICENSE_KEY=CC-Attribution-NonCommercial-NoDerivatives
